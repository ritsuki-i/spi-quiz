      "id": "Q001",
      "section": "nonverbal",
      "category": "order_reasoning",
      "weaknessTarget": "順番推理",
      "difficultyIndicator": 6,
      "timeLimitSec": 90,
      "answerType": "single",
      "prompt": "A, B, C, D, Eの5人が横一列に並んでいる。AはBより左，CはAより右，DはBより右，EはCより右にいる。このとき，必ず正しいものはどれか。",
      "choices": [
        {
          "id": "A",
          "text": "BはCより右にいる"
        },
        {
          "id": "B",
          "text": "AはEより左にいる"
        },
        {
          "id": "C",
          "text": "DはCより右にいる"
        },
        {
          "id": "D",
          "text": "CはBより左にいる"
        }
      ],
      "correctAnswer": "B",
      "patternType": "順番型",
      "firstMove": "A < C < E をまず確定する。BとDはAとの相対関係しかないため，Cとの関係は固定しない。",
      "explanation": "AはCより左，EはCより右なので A < C < E。したがってAはEより左にいる。BやDとCの関係は確定しない。"
    },
